<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pixel LED Diwali Automation</title>
    <!-- Include Paho MQTT JavaScript Client from CDN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/paho-mqtt/1.0.2/mqttws31.min.js"></script>
    <style>
        :root {
            --bg-color: #0f172a;
            --card-bg: #1e293b;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --accent-green: #22c55e;
            --accent-red: #ef4444;
            --accent-gold: #f59e0b;
        }

        body {
            font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-main);
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }

        .dashboard-card {
            background-color: var(--card-bg);
            width: 100%;
            max-width: 420px;
            padding: 30px;
            border-radius: 20px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3), 0 8px 10px -6px rgba(0, 0, 0, 0.3);
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        h2 {
            margin-top: 0;
            font-size: 20px;
            font-weight: 600;
            letter-spacing: 0.5px;
            text-align: center;
            margin-bottom: 20px;
            color: var(--accent-gold);
        }

        .status-indicators {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-bottom: 20px;
        }

        .indicator-box {
            background: rgba(15, 23, 42, 0.6);
            padding: 12px;
            border-radius: 12px;
            text-align: center;
            border: 1px solid rgba(255, 255, 255, 0.03);
        }

        .indicator-title {
            font-size: 12px;
            color: var(--text-muted);
            margin-bottom: 4px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .indicator-value {
            font-size: 14px;
            font-weight: bold;
        }

        .dot {
            height: 8px;
            width: 8px;
            background-color: var(--accent-red);
            border-radius: 50%;
            display: inline-block;
            margin-right: 5px;
        }

        .dot.active {
            background-color: var(--accent-green);
            box-shadow: 0 0 8px var(--accent-green);
        }

        .board-time-panel {
            background: rgba(15, 23, 42, 0.6);
            padding: 10px;
            border-radius: 10px;
            text-align: center;
            font-size: 14px;
            margin-bottom: 20px;
            color: var(--accent-gold);
            border: 1px solid rgba(255, 255, 255, 0.03);
        }

        .main-status-panel {
            text-align: center;
            background: rgba(15, 23, 42, 0.4);
            padding: 20px;
            border-radius: 14px;
            margin-bottom: 25px;
        }

        .load-title {
            font-size: 14px;
            color: var(--text-muted);
        }

        .load-state {
            font-size: 32px;
            font-weight: 700;
            margin-top: 5px;
        }

        .state-on { color: var(--accent-green); }
        .state-off { color: var(--accent-red); }

        .button-group {
            display: flex;
            gap: 12px;
        }

        .btn {
            flex: 1;
            padding: 14px;
            font-size: 16px;
            font-weight: 600;
            border: none;
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .btn-on {
            background-color: rgba(34, 197, 94, 0.15);
            color: var(--accent-green);
            border: 1px solid rgba(34, 197, 94, 0.3);
        }
        .btn-on:hover { background-color: var(--accent-green); color: white; }

        .btn-off {
            background-color: rgba(239, 68, 68, 0.15);
            color: var(--accent-red);
            border: 1px solid rgba(239, 68, 68, 0.3);
        }
        .btn-off:hover { background-color: var(--accent-red); color: white; }

        .schedule-info {
            margin-top: 25px;
            font-size: 13px;
            color: var(--text-muted);
            text-align: center;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            padding-top: 15px;
        }
    </style>
</head>
<body>

    <div class="dashboard-card">
        <h2>✨ Pixel LED Diwali Automation</h2>

        <!-- Status Indicators -->
        <div class="status-indicators">
            <div class="indicator-box">
                <div class="indicator-title">MQTT Broker</div>
                <div class="indicator-value"><span id="broker-dot" class="dot"></span><span id="broker-text">Connecting</span></div>
            </div>
            <div class="indicator-box">
                <div class="indicator-title">ESP8266 Board</div>
                <div class="indicator-value"><span id="board-dot" class="dot"></span><span id="board-text">Offline</span></div>
            </div>
        </div>

        <!-- Board Time Display -->
        <div class="board-time-panel">
            Board Time: <strong id="board-time-val">--:--:--</strong>
        </div>

        <!-- Main Load Status Display -->
        <div class="main-status-panel">
            <div class="load-title">Current Load State</div>
            <div id="status-text" class="load-state state-off">OFF</div>
        </div>

        <!-- Manual Control Buttons -->
        <div class="button-group">
            <button class="btn btn-on" onclick="sendMQTTCommand('ON')">Turn ON</button>
            <button class="btn btn-off" onclick="sendMQTTCommand('OFF')">Turn OFF</button>
        </div>

        <!-- Schedule Information -->
        <div class="schedule-info">
            Auto Schedule: <strong>18:00 ON</strong> | <strong>01:00 OFF</strong>
        </div>
    </div>

    <script>
        // MUST match the MQTT_BASE_PATH defined in your Arduino code exactly
        const MQTT_BASE_PATH = "home/automation/pixel_diwali_led/sec_99a8f7b6c5d4";

        const brokerHost = "broker.hivemq.com";
        const brokerPort = 8884; // Secure WebSocket port
        const clientId = "WebDashboard_" + Math.random().toString(16).substring(2, 8);
        
        const topicControl = MQTT_BASE_PATH + "/cmd/control_relay";
        const topicStatus  = MQTT_BASE_PATH + "/state/relay_feedback";
        const topicBoard   = MQTT_BASE_PATH + "/health/board_heartbeat";
        const topicTime    = MQTT_BASE_PATH + "/health/board_time";

        let client = null;
        let boardTimeout = null;

        function connectMQTT() {
            client = new Paho.MQTT.Client(brokerHost, Number(brokerPort), clientId);

            client.onConnectionLost = onConnectionLost;
            client.onMessageArrived = onMessageArrived;

            console.log("Connecting to MQTT broker...");

            client.connect({
                useSSL: true,
                timeout: 10,
                onSuccess: onConnect,
                onFailure: onFailure
            });
        }

        function onConnect() {
            console.log("Connected to Broker successfully!");
            document.getElementById("broker-dot").classList.add("active");
            document.getElementById("broker-text").innerText = "Connected";
            
            // Subscribe to status, board health, and time topics
            client.subscribe(topicStatus);
            client.subscribe(topicBoard);
            client.subscribe(topicTime);
        }

        function onFailure(message) {
            console.error("Connection failed:", message.errorMessage);
            document.getElementById("broker-dot").classList.remove("active");
            document.getElementById("broker-text").innerText = "Failed";
            setTimeout(connectMQTT, 5000); // Retry after 5s
        }

        function onConnectionLost(responseObject) {
            console.warn("Connection lost:", responseObject.errorMessage);
            document.getElementById("broker-dot").classList.remove("active");
            document.getElementById("broker-text").innerText = "Disconnected";
            document.getElementById("board-dot").classList.remove("active");
            document.getElementById("board-text").innerText = "Offline";
            document.getElementById("board-time-val").innerText = "--:--:--";
            setTimeout(connectMQTT, 5000); // Retry after 5s
        }

        function onMessageArrived(message) {
            console.log("Message received on topic:", message.destinationName, "->", message.payloadString);

            if (message.destinationName === topicStatus) {
                let state = message.payloadString;
                let statusDiv = document.getElementById("status-text");
                statusDiv.innerText = state;
                if (state === "ON") {
                    statusDiv.className = "load-state state-on";
                } else {
                    statusDiv.className = "load-state state-off";
                }
            } 
            else if (message.destinationName === topicBoard) {
                let boardState = message.payloadString;
                let boardDot = document.getElementById("board-dot");
                let boardText = document.getElementById("board-text");
                
                if (boardState === "ONLINE") {
                    boardDot.classList.add("active");
                    boardText.innerText = "Online";

                    // If no heartbeat arrives for 25 seconds, mark board offline
                    clearTimeout(boardTimeout);
                    boardTimeout = setTimeout(() => {
                        boardDot.classList.remove("active");
                        boardText.innerText = "Offline";
                        document.getElementById("board-time-val").innerText = "--:--:--";
                    }, 25000);
                }
            }
            else if (message.destinationName === topicTime) {
                let timeStr = message.payloadString;
                document.getElementById("board-time-val").innerText = timeStr;
            }
        }

        function sendMQTTCommand(command) {
            if (!client || !client.isConnected()) {
                alert("Not connected to MQTT broker yet!");
                return;
            }
            let message = new Paho.MQTT.Message(command);
            message.destinationName = topicControl;
            client.send(message);
            console.log("Command sent:", command);
        }

        // Start connection on page load
        window.onload = connectMQTT;
    </script>
</body>
</html>
